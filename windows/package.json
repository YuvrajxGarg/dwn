{
  "name": "dwn",
  "productName": "Dwn",
  "version": "1.0.0",
  "description": "Download anything on the internet.",
  "author": "Yuvraj Garg",
  "license": "MIT",
  "homepage": "https://github.com/YuvrajxGarg/dwn",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.yuvrajgarg.dwn",
    "productName": "Dwn",
    "copyright": "\u00a9 Yuvraj Garg",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../engine/build/dist/dwn-engine",
        "to": "engine"
      },
      {
        "from": "build/tray-white.png",
        "to": "tray-white.png"
      },
      {
        "from": "build/tray-white@2x.png",
        "to": "tray-white@2x.png"
      },
      {
        "from": "build/tray-black.png",
        "to": "tray-black.png"
      },
      {
        "from": "build/tray-black@2x.png",
        "to": "tray-black@2x.png"
      }
    ],
    "protocols": [
      {
        "name": "Dwn link",
        "schemes": [
          "dwn"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Dwn-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dwn",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "YuvrajxGarg",
        "repo": "dwn",
        "releaseType": "release"
      }
    ]
  }
}
